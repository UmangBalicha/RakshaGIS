# --- Supabase (optional) ---
# When these are set, the app talks to your real Supabase backend.
# When they are missing, the app runs in built-in DEMO MODE
# (local seeded data stored in the browser) so `npm run dev` works with zero setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Demo mode seed (optional) ---
# Set to "false" to start demo mode with an empty database.
VITE_DEMO_SEED=true

# --- Scaling (only needed beyond demo mode / heavy fleets) ---
# Self-hosted OSRM route server (e.g. http://your-osrm:5000/route/v1).
# Empty = OSRM public demo server with 15-min client cache + backoff.
VITE_OSRM_URL=
# Set to "false" to replace Supabase realtime fan-out with 30s polling
# (Supabase plans cap concurrent realtime connections).
VITE_REALTIME_ENABLED=true

# --- Analytics (optional, off by default) ---
# No tracking happens unless this is set — and even then, only through the
# hook in src/lib/analytics.js, which has no provider bundled. Leave empty
# to keep the build fully tracking-free.
VITE_ANALYTICS_ID=

# --- MapmyIndia / Mappls (optional) ---
# Official Government of India map boundaries (correct J&K, Ladakh,
# Arunachal Pradesh) as required for digital maps published in India.
# Free for dev/testing — sign up at https://www.mapmyindia.com/api/signup
# When empty, the app uses OpenStreetMap tiles (boundaries indicative).
VITE_MAPMYINDIA_KEY=
